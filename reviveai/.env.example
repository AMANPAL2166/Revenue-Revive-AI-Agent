# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# --- Database ---
DATABASE_URL=jdbc:mysql://localhost:3306/reviveai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=reviveai
DATABASE_PASSWORD=changeme
# Used by docker-compose for the mysql service itself:
MYSQL_DATABASE=reviveai
MYSQL_USER=reviveai
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- LLM ---
LLM_API_KEY=xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-5

# --- Demo mode ---
# When true, retry/reminder delays use *_SECONDS below instead of
# production-style hours, so the buildathon demo doesn't require waiting.
DEMO_MODE=true
DEMO_RETRY_DELAY_SECONDS=30
DEMO_REMINDER_DELAY_SECONDS=20

# --- App ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=demo
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api

