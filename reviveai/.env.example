# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/reviveai
DATABASE_USERNAME=reviveai
DATABASE_PASSWORD=changeme
# Used by docker-compose for the postgres service itself:
POSTGRES_DB=reviveai
POSTGRES_USER=reviveai
POSTGRES_PASSWORD=changeme

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- LLM ---
LLM_API_KEY=xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-6

# --- Demo mode ---
# When true, retry/reminder delays use *_SECONDS below instead of
# production-style hours, so the buildathon demo doesn't require waiting.
DEMO_MODE=true
DEMO_RETRY_DELAY_SECONDS=30
DEMO_REMINDER_DELAY_SECONDS=20

# --- App ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=demo

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api
